; ============================================================
; XAU Sniper — Corrected Test Preset
; Account: 100k Demo
; Last updated: 2026-03-19
;
; Changes from original preset:
;   [1] SniperATRStopMultiplier: 0.65 -> 1.20
;       Stop was inside M5 XAUUSD wick noise. At 1.20x ATR
;       the stop has room to breathe without killing R:R.
;   [2] ATRTrailingMultiplier: 2.20 -> 1.30
;       Was identical to TP — trail never activated in practice.
;       Now trails meaningfully once trade is in profit.
;   [3] SniperBiasTimeframe: 15 -> 60 (H1)
;       M15 34/144 EMA flips too frequently for M5 entries.
;       H1 reflects session-level trend — aggressive entry,
;       stable directional brain.
;   [4] ActiveSessionStartHour: 0 -> 7 (GMT)
;       Was trading 24hrs including Asian noise.
;   [5] ActiveSessionEndHour: 24 -> 20 (GMT)
;       Cuts late NY session where M5 XAUUSD volume drops.
;   [6] CooldownBarsAfterLoss: 2 -> 6
;       10 min cooldown was too short. 30 min gives structure
;       time to show whether loss was a wick or a reversal.
;   [7] BreakEvenTriggerPoints: 500 -> 220
;       At old stop size, 500pts = 3-5R away — never triggered.
;       220pts is ~1R at the corrected stop size.
;   [8] BreakEvenLockPoints: 120 -> 80
;       Scaled down to match corrected stop/TP distances.
;   [9] MaxTradesPerDay: 8 -> 4
;       Corrected engine produces 2-4 quality signals per
;       session. 8 was chasing marginal setups.
; ============================================================

MagicNumber=2026031702
Slippage=10
MaxSpreadPoints=180

; --- Strategy core ---
StrategyMode=2
TrendTimeframe=60
HigherBiasTimeframe=240
FastEMA=50
SlowEMA=200
PullbackEMA1=20
PullbackEMA2=50

; --- Sniper engine ---
; [3] H1 bias: stable session-level trend for M5 aggressive entries
SniperBiasTimeframe=60
SniperFastEMA=34
SniperSlowEMA=144
SniperPullbackEMA=20
SniperUseSecondEMA=true
SniperPullbackEMA2=50

; --- ATR profile ---
UseSniperATRProfile=true
; [1] Stop widened from 0.65 to 1.20 — was inside wick noise
SniperATRStopMultiplier=1.20
SniperATRTakeProfitMultiplier=2.20
ATRPeriod=14
MinATR=1.2
MaxATR=1000.0

; --- Standard ATR stops (non-sniper mode fallback) ---
UseATRStops=true
ATRStopMultiplier=0.80
ATRTakeProfitMultiplier=2.20

; --- Regime filter ---
UseRegimeFilter=false
RegimeMinATR=2.0
RegimeMaxATR=35.0
RegimeMinEMASeparationPoints=40.0
RegimeChaoticCandleATRRatio=3.0

; --- Multi-timeframe bias ---
UseMultiTimeframeBias=true

; --- Session filter ---
; [4][5] Active hours 07:00-20:00 GMT covers London open through NY close
UseSessionPreset=false
SessionPreset=3
StartHour=7
EndHour=20
ActiveSessionStartHour=7
ActiveSessionEndHour=20

; --- Risk management ---
UseRiskPercent=true
RiskPercent=1.0
FixedLotSize=0.01
RiskUseEquity=true
MaxCalculatedLot=1.00

; --- Stop and target distances ---
MinStopDistancePoints=250
StopLossPoints=300
TakeProfitPoints=600

; --- Break-even ---
; [7][8] Scaled to ~1R at corrected stop size
UseBreakEven=true
BreakEvenTriggerPoints=220
BreakEvenLockPoints=80

; --- Partial close ---
UsePartialClose=false
PartialClosePercent=50.0
PartialCloseTriggerPoints=180

; --- Trailing stop ---
; [2] Tightened from 2.20 to 1.30 so trail activates before TP
UseATRTrailing=true
ATRTrailingMultiplier=1.30

; --- Daily guards ---
UseDailyGuard=true
; [9] Reduced from 8 — corrected engine yields 2-4 quality signals/session
MaxTradesPerDay=4
MaxConsecutiveLosses=5
UseMaxDailyLossPercent=true
MaxDailyLossPercent=2.0
MaxOpenPositions=2

; --- Candle filter ---
UseAbnormalCandleFilter=false
MaxCandleToATRRatio=2.5

; --- EMA separation filter ---
UseEMASeparationFilter=true
MinEMASeparationPoints=30.0

; --- Logging ---
EnableDebugLogs=true
EnableVerboseSignalLogs=true

; --- Developer mode (all OFF — real account safety) ---
DeveloperTestMode=false
DeveloperIgnoreConfirmation=false
DeveloperIgnoreExtraFilter=false
DeveloperIgnoreAbnormalCandle=false
DeveloperIgnoreTrendStrength=false
DeveloperIgnoreRejection=false
DeveloperIgnoreRegimeFilter=false
DeveloperIgnoreMultiTimeframeBias=false

; --- Spread protection ---
UseSpreadSpikeProtection=true
SpreadAveragePeriod=20
SpreadSpikeMultiplier=3.0

; --- Trade cooldown ---
UseTradeCooldown=true
CooldownBarsAfterTrade=2
; [6] Increased from 2 — 30 min cooldown after a loss
CooldownBarsAfterLoss=6

; --- Display ---
ShowStatusPanel=true
StatusPanelCorner=0
StatusPanelX=10
StatusPanelY=20

; --- CSV logging ---
EnableCSVLogging=true
CSVFileName=XAU_Sniper_Test_Log.csv
